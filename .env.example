# Public Store Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Qadivio Store"
NEXT_PUBLIC_STORE_SLOGAN="بوابتك الموثوقة للاشتراكات الرقمية وأدوات الذكاء الاصطناعي"
NEXT_PUBLIC_WHATSAPP_PHONE="213555000000"

# Meta Pixel (Facebook Ads)
# ضع معرف بيكسل ميتا الحقيقي هنا (مثال: 967680699242701)
NEXT_PUBLIC_META_PIXEL_ID=967680699242701
NEXT_PUBLIC_META_PIXEL_DEBUG=true

# Admin Authentication Secret
ADMIN_PASSWORD=admin123456
ADMIN_SECRET_KEY=qadivio-secure-admin-jwt-key-2026

# Supabase / PostgreSQL Configuration (اختياري - يعمل النظام محلياً بشكل افتراضي)
# إذا أردت الربط مع Supabase Cloud، قم بتعبئة المتغيرات التالية:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Payment Accounts Information (معلومات الحسابات البريدية والبنكية للعملاء)
NEXT_PUBLIC_BARIDIMOB_RIP=00799999000123456789
NEXT_PUBLIC_BARIDIMOB_HOLDER="QADIVIO DIGITAL SERVICES"
NEXT_PUBLIC_CCP_ACCOUNT=0012345678
